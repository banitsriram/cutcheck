# Names only. Copy to .env.local and fill in the values locally; never commit them.
# In production the values live in the Vercel project settings. Preview deployments get no
# YouCam key, so they always run in demo mode.

# YouCam (server only)
YOUCAM_API_KEY=
YOUCAM_BASE_URL=
# Kill switch: "true" stops every paid YouCam call
YOUCAM_DISABLED=false

# Sessions, stylist card and judge pass (server only; long random strings)
SESSION_SECRET=
CARD_SECRET=
JUDGE_CODE=

# Upstash Redis (server only). Vercel's KV_REST_API_URL / KV_REST_API_TOKEN also work.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Cloudflare Turnstile (optional in local dev)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

# Unit budget: public traffic gets demo mode at 0; judges draw on their own reserve
PUBLIC_DAILY_UNIT_CAP=0
JUDGE_UNIT_CAP=40
